# 카드뉴스 에이전트 가이드북 2편 — 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 저장하세요. .env는 절대 깃허브에 올리지 마세요.

# Anthropic (Claude) — 카피 생성, 자기 평가
ANTHROPIC_API_KEY=sk-ant-여기에-클로드-키-붙여넣기

# OpenAI (DALL-E) — 배경 이미지 생성
OPENAI_API_KEY=sk-여기에-오픈AI-키-붙여넣기

# 구글 시트
# 서비스 계정 이메일을 시트에 '편집자'로 공유한 뒤 아래 값을 채우세요.
SHEET_URL=https://docs.google.com/spreadsheets/d/여기에-시트ID/edit
CREDS_FILE=./service_account.json
