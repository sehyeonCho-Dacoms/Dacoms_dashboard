# ── 시트 백엔드 ───────────────────────────────
# local = CSV(sample_data/)로 개발/테스트, google = 실제 구글 시트
SHEET_BACKEND=local

# ── 구글 시트 (SHEET_BACKEND=google 일 때) ──────
# 서비스 계정 JSON 키 파일 경로 (시트를 서비스 계정 이메일과 공유해야 함)
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
SPREADSHEET_ID=
TOPIC_WORKSHEET=주제입력
DRAFT_WORKSHEET=카피초안

# ── Anthropic (Claude) ────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
ANGLES_PER_TOPIC=5

# ── OpenAI (표지 이미지 생성, 선택) ─────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# ── 브랜드 템플릿 ─────────────────────────────
BRAND_NAME=DACOMS
BRAND_PRIMARY=#2563eb
BRAND_SECONDARY=#1d4ed8
BRAND_ACCENT=#60a5fa
BRAND_INK=#0f172a
CARD_WIDTH=1080
CARD_HEIGHT=1350

# ── 출력 ─────────────────────────────────────
OUTPUT_DIR=output
LOCAL_DATA_DIR=sample_data
