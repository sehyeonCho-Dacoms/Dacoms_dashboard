# ── 활성 소스 ─────────────────────────────────
# 쉼표구분. 자격증명 없는 소스는 자동으로 건너뜀. 오프라인 체험은 sample.
# ksoc(대한체육회 공개 게시판)는 키 없이 바로 수집 가능.
# 예) JOB_SOURCES=ksoc,saramin,worknet
JOB_SOURCES=sample

# 수집 키워드(쉼표구분) — 스포츠 산업 중심
JOB_KEYWORDS=스포츠,피트니스,골프,구단,스포츠마케팅
JOB_PER_SOURCE_LIMIT=50

# ── 사람인 채용정보 오픈 API (공식) ─────────────
# 발급: https://oapi.saramin.co.kr (마이페이지 > 오픈API 액세스키)
SARAMIN_ACCESS_KEY=

# ── 워크넷/고용24 채용정보 API (공식) ───────────
# 발급: 공공데이터포털(data.go.kr) 또는 work.go.kr 오픈API
WORKNET_AUTH_KEY=

# ── 원티드 크롤러 (비공식·ToS 확인 필수) ─────────
# robots.txt/이용약관 확인 후, 동의하는 경우에만 true 로 활성화
WANTED_CRAWLER_ENABLED=false

# ── 대한체육회 채용공고 게시판 (공개·키 불필요) ────
# 다른 eGov 게시판도 이 URL만 바꿔 재사용 가능(bbsId·menuNo 자동 추출)
KSOC_LIST_URL=https://sports.or.kr/sports/bbs/BMSR00024/list.do?menuNo=200027
KSOC_PAGES=2

# ── 구글 프로그래머블 검색 (사람인·잡코리아 등 공식 API 없는 사이트 발견용) ──
# 사람인/잡코리아 서버를 직접 긁지 않고, 구글이 이미 색인한 제목/링크/스니펫만
# 구글 "공식" Custom Search JSON API로 조회한다. 무료 100건/일.
# 발급: 1) programmablesearchengine.google.com 에서 검색엔진 생성(전체 웹 검색) → cx 확인
#      2) console.cloud.google.com 에서 Custom Search API 활성화 → API 키 발급
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_SITES=saramin.co.kr,jobkorea.co.kr
GOOGLE_CSE_PAGES=1
GOOGLE_CSE_DAILY_CAP=90

# ── HTTP 매너 ─────────────────────────────────
REQUEST_DELAY_SEC=1.0
HTTP_USER_AGENT=DraftOnBot/0.1 (+https://drafton.example; contact ops@drafton.example)

# ── 경로 ──────────────────────────────────────
# 스토어/샘플 경로는 레포 루트 기준 상대경로 (CLI는 레포 루트에서 실행)
JOB_DATA_DIR=job_pipeline/data
SAMPLE_RAW_PATH=job_pipeline/sample_data/raw_sample.json
# 대시보드(dashboard.html)가 fetch 하는 산출물 — 루트의 data/ 아래
DASHBOARD_JSON=data/dashboard.json
