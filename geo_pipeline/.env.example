# ── 활성 소스 ─────────────────────────────────
# 쉼표구분. 자격증명 없는 소스는 자동으로 건너뜀. 오프라인 체험은 sample.
# 예) GR_SOURCES=naver,tistory_cse   또는   GR_SOURCES=naver,tistory_manual
GR_SOURCES=sample

# 검색어당 상위 N개 (허브 기준 5)
GR_TOP_N=5
# 2차 수집: 검색어 × 형식 수식어(총정리·비교·후기·…) — 호출 수가 8배가 되니 필요할 때만
GR_WITH_MODIFIERS=false

# 글 페이지를 열어 구조 지표를 자동 측정할지.
# ⚠️ RULE-11: 대상 사이트 이용약관 확인 후에만 true. robots.txt가 막는 글은 true여도 열지 않음.
# false면 목록(제목·링크·발행일·제목 패턴)만 남기고 구조 칸은 '사람 기록'.
GR_FETCH_PAGES=false

# ── 네이버 검색 API (공식, 블로그 검색) ─────────
# 발급: https://developers.naver.com/apps → 애플리케이션 등록 → 사용 API '검색'
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 티스토리: Google Programmable Search (공식) ─
# 키: Google Cloud 콘솔 'Custom Search API' / CX: programmablesearchengine.google.com
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ── 티스토리: 사람이 링크를 붙여 넣는 CSV (CSE 대신) ─
# 열: group,keyword,rank,url[,title] — 예시: geo_pipeline/sample_data/tistory_urls.example.csv
GR_TISTORY_URLS_CSV=

# ── HTTP 매너 ─────────────────────────────────
REQUEST_DELAY_SEC=2.0
HTTP_USER_AGENT=DoctorOnGeoBot/0.1 (+https://doctoronhr.tistory.com)

# ── 경로 (레포 루트 기준) ──────────────────────
GR_OUT_DIR=geo_pipeline/out
GR_SAMPLE_DIR=geo_pipeline/sample_data
