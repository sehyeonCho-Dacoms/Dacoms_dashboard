# ── 활성 소스 ─────────────────────────────────
# 쉼표구분. 자격증명 없으면 자동으로 sample만 남는다.
METRICS_SOURCES=sample

# ── 인스타그램(Meta Graph API) ───────────────────
# 발급 절차 요약:
#   1) Meta for Developers(developers.facebook.com)에서 앱 생성
#   2) 인스타그램 계정을 "프로페셔널(비즈니스/크리에이터)"로 전환하고
#      페이스북 페이지에 연결
#   3) Graph API Explorer 또는 시스템 사용자 토큰으로
#      instagram_basic, instagram_manage_insights, pages_read_engagement,
#      pages_show_list 권한을 가진 장기 액세스 토큰 발급
#   4) GET /me/accounts → 페이지 → GET /{page-id}?fields=instagram_business_account
#      로 IG_BUSINESS_ACCOUNT_ID 확인
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_API_VERSION=v21.0
# 콤마구분. 미디어 타입에 따라 일부 지표는 자동으로 개별 재시도/스킵됨.
IG_INSIGHTS_METRICS=reach,saved,shares,likes,comments,total_interactions,profile_activity
IG_LOOKBACK_DAYS=35

# ── 게시물 메타데이터 레지스트리 ─────────────────
# post_id,topic,sport_category,format 컬럼의 CSV. 게시 담당자가 직접 관리.
POST_REGISTRY_PATH=metrics_pipeline/data/post_registry.csv

# ── HTTP 매너 ─────────────────────────────────
REQUEST_DELAY_SEC=0.5

# ── 경로 ──────────────────────────────────────
METRICS_DATA_DIR=metrics_pipeline/data
SAMPLE_RAW_PATH=metrics_pipeline/sample_data/raw_metrics_sample.json
# metrics-analyzer 에이전트가 읽는 최종 산출물 — 루트의 data/ 아래
METRICS_CSV=data/card_news_metrics.csv
